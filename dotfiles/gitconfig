[user]
	name = Jim Posen
	email = jim.posen@gmail.com
[alias]
	co = checkout
	cb = checkout -b
	ma = !git switch "$(git config init.defaultBranch)"
	unstage = reset HEAD --
	rh = reset --hard HEAD
	re = rebase
	rema = !git rebase "$(git config init.defaultBranch)"
	st = status
	sw = switch
	br = branch
	cm = commit
	df = diff
[core]
	editor = vim
	autocrlf = input
	pager = delta
[push]
	default = simple
[color]
	ui = auto
[include]
	path = .gitconfig.local
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3

